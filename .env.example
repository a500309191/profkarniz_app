# Fill these locally. Never commit real secrets. Values below are NOT credentials.
TELEGRAM_BOT_TOKEN=
POSTGRES_PASSWORD=
POSTGRES_USER=profkarniz
POSTGRES_DB=profkarniz
# Local Node process; Docker Compose overrides PGHOST to postgres.
PGHOST=127.0.0.1
PGPORT=5432
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Only docker-compose.host-network.yml: PostgreSQL publishes on 127.0.0.1.
HOST_POSTGRES_PORT=55432
LOG_LEVEL=info
TELEGRAM_POLL_TIMEOUT_SECONDS=30
HEALTH_STALE_SECONDS=120
SHUTDOWN_TIMEOUT_SECONDS=25

# Media archival is opt-in. All five S3 values are required when enabled.
MEDIA_ARCHIVE_ENABLED=false
MEDIA_CONCURRENCY=2
MEDIA_MAX_ATTEMPTS=5
MEDIA_JOB_TIMEOUT_SECONDS=180
MEDIA_MAX_FILE_BYTES=20971520
S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_BUCKET=profkarniz-storage
# false selects virtual-hosted-style for DNS-compatible vHosted buckets.
# Keep the regional S3_ENDPOINT above; SDK adds the bucket hostname itself.
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
