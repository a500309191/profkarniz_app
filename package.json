{
  "name": "profkarniz-app",
  "version": "0.1.0",
  "private": true,
  "description": "Passive, durable Telegram collector for ПРОФКАРНИЗ",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:local": "node --env-file=.env --import tsx src/db/migrate.ts",
    "migrate:production": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:compose": "node tests/check-compose.mjs",
    "test:production-cli": "node tests/check-production-cli.mjs",
    "media:backfill": "node dist/media/cli.js backfill",
    "media:retry-failed": "node dist/media/cli.js retry-failed",
    "s3:check": "node dist/media/cli.js s3-check",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "10.11.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
